# Server
PORT=4000
NODE_ENV=development

# ── Local MySQL (dev) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=arte_store

# ── Railway MySQL (set automatically by Railway when you add MySQL plugin) ──
# MYSQL_URL=mysql://user:pass@host:port/dbname
# MYSQLHOST=
# MYSQLPORT=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=

# CORS — set to your Railway frontend URL in production
FRONTEND_URL=http://localhost:3000
